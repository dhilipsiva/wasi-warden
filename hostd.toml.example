# Copy to hostd.toml (git-ignored, since it holds an API key) and edit. hostd reads ./hostd.toml by
# default (`--config` to change it); without one, the workspace is the current directory, no command
# may run and no LLM is configured.

# The directory the fs capability is confined to (overridden by --workspace).
workspace_root = "./sandbox"

# Programs the proc capability may run (more with --allow-proc): bare names, resolved through PATH when
# hostd starts, or absolute paths. A program missing here is a configuration error.
allow_proc = ["ls", "echo"]

# Environment variables a plan may set for those programs; none when unset. PATH (the host sets it),
# the loader's and shell hooks are refused even if listed.
# allow_env = ["LANG"]

# Any OpenAI-compatible chat-completions endpoint. This one is a local Ollama.
[llm]
api_base = "http://127.0.0.1:11434/v1"
api_key = "ollama"
model = "phi3.5"

# Or several, in place of the endpoint above (docs/design/router.md): local ones are tried first, the
# next on any failure, and paid ones (non-zero prices, per million tokens) only while llm_cost_micros
# lasts.
# [[llm.providers]]
# name = "box"
# tier = "local"
# api_base = "http://127.0.0.1:11434/v1"
# api_key = "ollama"
# model = "qwen2.5-coder:7b"
# timeout_ms = 30000
# [[llm.providers]]
# name = "frontier"
# tier = "frontier"
# api_base = "https://gateway.example/v1"
# api_key = "..."
# model = "claude-sonnet-5-5"
# input_price = 2.0
# output_price = 10.0

# The run's budgets (the defaults shown). Each operation is paid for before it runs.
# [budgets]
# steps = 8                       # planner rounds
# wallclock_ms = 600000           # the run, from when the component is compiled
# llm_tokens = 200000             # as the endpoint reports them
# processes = 32
# filesystem_ops = 10000
# browser_actions = 200
# llm_cost_micros = 1000000        # LLM spend at the providers' prices, in millionths of their unit
# guest_fuel = 10000000000        # wasm work per round; 0 for no limit
# guest_memory_bytes = 268435456  # the agent's memories and tables, together

# What the plan may do to the workspace through the fs capability.
# [workspace]
# read_only = false
# max_file_bytes = 16777216

# Host-side secrets. A plan names one as {{secret:NAME}}; the host fills it in only in text typed into a
# page and in a spawned process's environment values, and redacts every value from what reaches the model,
# the observations, the audit log and the log lines.
# [secrets]
# demo_username = "demo-user"
# demo_password = { env = "DEMO_PASSWORD" }

# One JSON line per capability call (the planner's actions and the agent's WIT calls), with outputs
# digested, not recorded.
# [audit]
# path = "hostd-audit.jsonl"

# One JSON line per LLM request attempt: provider, outcome, tokens, cost, latency (docs/design/telemetry.md).
# [telemetry]
# path = "hostd-telemetry.jsonl"

# Browser tasks need a running WebDriver (Chromedriver, Geckodriver, ...).
# [browser]
# webdriver_url = "http://127.0.0.1:9515"
# default_profile = "default"
# The hosts the browser may visit over http(s), `*.example.com` for subdomains; none when unset.
# allowed_hosts = ["demo.example"]
# Launch Chrome without its sandbox, only where the sandbox cannot run (some containers).
# chrome_no_sandbox = false
